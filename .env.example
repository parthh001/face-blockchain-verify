# --- Reverse image / social search ---
# SEARCH_PROVIDER = "serpapi" (default, Google Lens via SerpApi)
#                 = "bing"    (Azure Bing Visual Search, no public-URL upload needed)
#                 = "mock"    (no network, no key -- rehearsal only, NOT for your submission)
SEARCH_PROVIDER=serpapi

# Get a free trial key at https://serpapi.com/ (100 free searches/month)
SERPAPI_KEY=your_serpapi_key_here

# Only needed if SEARCH_PROVIDER=bing (Azure Cognitive Services -> Bing Search v7)
AZURE_BING_KEY=

# --- Blockchain ---
# CHAIN_MODE = "local" (default, fully simulated, no setup, no cost)
#            = "testnet" (real public testnet, e.g. Polygon Amoy)
CHAIN_MODE=local

# Only required when CHAIN_MODE=testnet
RPC_URL=https://rpc-amoy.polygon.technology
PRIVATE_KEY=your_testnet_wallet_private_key_here
